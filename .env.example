# Copy to .env for local builds. Real secrets live in GitHub repository secrets and the
# host's secret store, never in this repository.

# Which tenant folder to build (see /tenants)
TENANT=_template

# Optional: override the site URL (defaults to https://<tenant domain>)
# SITE_URL=http://localhost:4321

# Optional: "staging" blocks crawlers via robots.txt and noindex
# SITE_ENV=staging

# Deploy credentials (GitHub secrets, used by .github/workflows/deploy-site.yml)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Dashboard (set these on the dashboard host, not in this file) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SESSION_SECRET=         # 32+ random characters
# SETUP_TOKEN=            # one-time, enables /setup; remove after creating the owner
# GITHUB_TOKEN=           # fine-grained, this repository only
# GITHUB_OWNER=
# GITHUB_REPO=
# RESEND_API_KEY=
# NOTIFY_FROM=

# --- Agent, tracker, billing (GitHub Actions secrets; see docs/SETUP.md) ---
# ANTHROPIC_API_KEY=      # per-business override: ANTHROPIC_API_KEY__<ID>
# PERPLEXITY_API_KEY=
# OPENAI_API_KEY=
# OPENAI_TRACKER_MODEL=
# AGENT_GITHUB_TOKEN=
# GSC_CLIENT_ID= GSC_CLIENT_SECRET= GSC_REFRESH_TOKEN=
# BILLING_WEBHOOK_URL= BILLING_WEBHOOK_SECRET=
